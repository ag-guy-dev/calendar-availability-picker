<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">

  <!-- IMPORTANT: Generate a real GUID for production, e.g. via `uuidgen` -->
  <Id>4f1a1e2b-6c3d-4a7e-9f2a-8e5b7c6d1a90</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Personal</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Availability Picker" />
  <Description DefaultValue="Pick open times from your Outlook calendar and drop them into an email as a list, without a voting link." />
  <IconUrl DefaultValue="https://REPLACE_WITH_YOUR_HOSTED_DOMAIN/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://REPLACE_WITH_YOUR_HOSTED_DOMAIN/assets/icon-80.png" />
  <SupportUrl DefaultValue="https://REPLACE_WITH_YOUR_HOSTED_DOMAIN/support.html" />

  <AppDomains>
    <AppDomain>https://login.microsoftonline.com</AppDomain>
    <AppDomain>https://login.live.com</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.5" />
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://REPLACE_WITH_YOUR_HOSTED_DOMAIN/taskpane.html" />
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadWriteItem</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit" />
  </Rule>

  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.5">
        <bt:Set Name="Mailbox" />
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url" />
          <ExtensionPoint xsi:type="MessageComposeCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="msgComposeGroup">
                <Label resid="GroupLabel" />
                <Control xsi:type="Button" id="msgComposeOpenPaneButton">
                  <Label resid="PaneButtonLabel" />
                  <Supertip>
                    <Title resid="PaneButtonLabel" />
                    <Description resid="PaneButtonTooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://REPLACE_WITH_YOUR_HOSTED_DOMAIN/assets/icon-16.png" />
        <bt:Image id="Icon.32x32" DefaultValue="https://REPLACE_WITH_YOUR_HOSTED_DOMAIN/assets/icon-32.png" />
        <bt:Image id="Icon.80x80" DefaultValue="https://REPLACE_WITH_YOUR_HOSTED_DOMAIN/assets/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://REPLACE_WITH_YOUR_HOSTED_DOMAIN/commands.html" />
        <bt:Url id="Taskpane.Url" DefaultValue="https://REPLACE_WITH_YOUR_HOSTED_DOMAIN/taskpane.html" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="Availability" />
        <bt:String id="PaneButtonLabel" DefaultValue="Pick Times" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="PaneButtonTooltip" DefaultValue="Open your calendar and insert available times into this email" />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
